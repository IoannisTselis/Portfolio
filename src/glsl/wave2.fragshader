precision highp float;
varying vec2 vUv;
uniform float uTime;
uniform float uIntensity;
uniform vec2 uMouse; 
uniform float uAspect;
uniform float uHover;

float radius_hash (vec2 id)
{
    id = fract(id * vec2(sin(id.x * 9932.2) * 9342.12 , cos(id.y*2300.2)*34557.12));
    id += 5.0 * dot(id, id + 32.12);
    return fract(id.x * id.y);
}

void main() {
    vec2 uv = vUv;
    float grid_size = 5.0;
    int neighbors = 1;

    vec2 aspectUV = vec2(uv.x * uAspect, uv.y);
    vec2 gridUV = aspectUV * grid_size;          
    vec2 grid_coordinates = floor(gridUV);

    float radius = 0.2;                         
    vec3 finalColor = vec3(0.0);

    for (int x = -neighbors; x <= neighbors; x++) {
        for (int y = -neighbors; y <= neighbors; y++) {
            vec2 local_cell = grid_coordinates + vec2(float(x), float(y));
            vec2 center_point = local_cell + vec2(0.5);

            float radiush = radius_hash(local_cell);
            float local_radius = (sin(240.0 * radiush + uTime)) * radius;
            
            float center_point_dist = distance(center_point, gridUV);
            float dist_pow = pow(center_point_dist/local_radius, 1.0);

            float inv_pow = pow((1.0-center_point_dist/local_radius), 5.0);
            if (distance(center_point, gridUV) < local_radius) {

                finalColor = vec3(smoothstep(0.0, 1.0, dist_pow));
            }
        }
    }

    vec3 bgColor = vec3(0.005, 0.02, 0.01);
    float edgeFader = smoothstep(0.5, 0.2, abs(uv.y - 0.5));
    gl_FragColor = vec4(finalColor * edgeFader + bgColor, 1.0);
}